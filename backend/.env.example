# DelQuro Connect — backend environment.
# Copy this file to backend/.env and fill in real values:
#   cp backend/.env.example backend/.env

# --- required ---------------------------------------------------------------
MONGO_URL=mongodb://localhost:27017
DB_NAME=delquro_connect
JWT_SECRET=

# --- optional ---------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API.
# Defaults to no cross-origin browser access when unset.
CORS_ORIGINS=

# One-time code that lets the very first user create the admin account.
ADMIN_BOOTSTRAP_CODE=

# Port used by the Docker image / uvicorn (defaults to 8000).
PORT=8000
