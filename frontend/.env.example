# DelQuro Connect — frontend environment.
# Copy this file to frontend/.env (CRA reads it on start/build).

# Absolute base URL of the FastAPI backend, e.g. https://api.example.com
# Leave it empty (or delete the line) to call the relative "/api" path — that
# is what same-origin deployments use, and `npm start` proxies /api to the
# backend defined by BACKEND_PROXY_TARGET below.
REACT_APP_BACKEND_URL=

# Only used by `npm start` when REACT_APP_BACKEND_URL is empty.
# BACKEND_PROXY_TARGET=http://127.0.0.1:8000
