{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "staff-test": {
      "distribution": "store",
      "environment": "preview",
      "autoIncrement": true,
      "env": { "CONNECT_REQUIRE_HTTPS": "1" },
      "ios": { "image": "sdk-57" },
      "android": { "image": "sdk-57", "buildType": "app-bundle" }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": { "CONNECT_REQUIRE_HTTPS": "1" },
      "ios": { "image": "sdk-57" },
      "android": { "image": "sdk-57", "buildType": "apk" }
    },
    "production": {
      "distribution": "store",
      "environment": "production",
      "autoIncrement": true,
      "env": { "CONNECT_REQUIRE_HTTPS": "1" },
      "ios": { "image": "sdk-57" },
      "android": { "image": "sdk-57", "buildType": "app-bundle" }
    }
  }
}
