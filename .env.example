# DelQuro Connect — deployment environment (Docker / Coolify / docker compose).
# Copy to .env for `docker compose up`, or paste these keys into the
# application's Environment Variables page in Coolify.
#   cp .env.example .env

# --- required ---------------------------------------------------------------
# Coolify MongoDB resource → copy the *internal* connection string, e.g.
# mongodb://root:<generated-password>@mongodb-<uuid>:27017/?authSource=admin
MONGO_URL=mongodb://mongo:27017
DB_NAME=delquro_connect

# 32+ random characters. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# --- optional ---------------------------------------------------------------
# One-time code that lets the FIRST user create the admin account
# (/setup in the app). Change it after bootstrapping, or remove it once an
# admin exists — registration is then closed to it automatically.
ADMIN_BOOTSTRAP_CODE=DELQURO-SETUP-2026

# Comma-separated browser origins allowed to call the API. Only needed for the
# split (separate frontend domain) topology; the all-in-one image serves the app
# and the API from the same origin, so this can stay "*".
CORS_ORIGINS=*

# Port the container listens on (Coolify: also set "Ports Exposes" to 8000).
PORT=8000

# docker-compose only: host port to publish (defaults to 8000).
APP_PORT=8000
