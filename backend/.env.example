# DelQuro Connect — backend environment.
# Copy this file to backend/.env and fill in real values:
#   cp backend/.env.example backend/.env

# --- required ---------------------------------------------------------------
MONGO_URL=mongodb://localhost:27017
DB_NAME=delquro_connect
JWT_SECRET=change-me-to-a-long-random-string

# --- optional ---------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API.
# Defaults to "*" (any origin) when unset.
CORS_ORIGINS=*

# One-time code that lets the very first user create the admin account.
ADMIN_BOOTSTRAP_CODE=DELQURO-SETUP-2026

# Port used by the Docker image / uvicorn (defaults to 8000).
PORT=8000
